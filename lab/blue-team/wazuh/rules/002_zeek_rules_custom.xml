<group name="zeek_custom,">
  <!-- Reverse Shell -->
  <rule id="100909" level="5">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/possible_malware.log</location>
    <field name="event_type">possible_malware</field>
    <field type="pcre2" name="sha1">\w+</field>
    <description>Zeek: file $(file_name) possible malware, source ip $(src_ip), destination ip $(dest_ip), destination port $(dest_port), mime type $(mime_type), total bytes $(total_bytes), sha1 $(sha1), sha256 $(sha256), note $(note).</description>
    <group>zeek_custom,malware,reverse_shell_stage,</group>
  </rule>
  <rule id="100910" level="5">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/reverse_shell_live.log</location>
    <field name="event_type">reverse_shell_live</field>
    <description>Zeek: Possible Reverse shell (live). uid: $(uid), source ip: $(src_ip), destination ip: $(dest_ip), destination port: $(dest_port), payload type: $(weird_name).</description>
    <group>zeek_custom,reverse_shell_stage,reverse_shell_start_chain,</group>
  </rule>
  <rule id="100911" level="5">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/reverse_shell_final.log</location>
    <field name="event_type">reverse_shell_final</field>
    <description>Zeek: Possible Reverse shell (closed). uid: $(uid), source ip: $(src_ip), destination ip: $(dest_ip), destination port: $(dest_port), payload type: $(weird_name), duration: $(duration), origin bytes: $(orig_bytes), response bytes: $(resp_bytes).</description>
    <group>zeek_custom,reverse_shell_stage,</group>
  </rule>
  <rule id="100912" level="5">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/reverse_shell_movement.log</location>
    <field name="event_type">reverse_shell_movement</field>
    <description>Zeek: Possible Reverse shell (traffic). uid: $(uid), source ip: $(src_ip), destination ip: $(dest_ip), destination port: $(dest_port), payload type: $(weird_name), duration: $(duration), origin bytes: $(orig_bytes), response bytes: $(resp_bytes), origin packets: $(orig_pkts), responsepackets: $(resp_pkts).</description>
    <group>zeek_custom,reverse_shell_stage,</group>
  </rule>

  <!-- Data Exfiltration -->
  <rule id="100913" level="3">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/data_exfiltration.log</location>
    <field name="event_type">baseline_completed</field>
    <description>Zeek: Baseline completed and dynamic threshold calculated. src_ip: $(src_ip)</description>
    <group>zeek_custom,data_exfiltration,</group>
  </rule>
  <rule id="100914" level="8">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/data_exfiltration.log</location>
    <field name="event_type">possible_data_exfiltration</field>
    <description>Zeek: Total outgoing bytes exceeding the dynamic threshold. Possible Data Exfiltration. src_ip: $(src_ip), dest_ip: $(dest_ip):$(dest_port)</description>
    <group>zeek_custom,data_exfiltration,</group>
  </rule>

  <!-- Scanning (nmap) -->
  <rule id="100915" level="6">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/scanning.log</location>
    <field name="event_type">^host_scan$</field>
    <description>Zeek: Possible ARP host scanning detected by IP $(src_ip)</description>
    <group>zeek_custom,zeek_scanning,host_scan,</group>
  </rule>

  <rule id="100916" level="7">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/scanning.log</location>
    <field name="event_type">^port_scan$</field>
    <description>Zeek: Possible TCP port scanning detected by IP $(src_ip), victim IP $(target_ip)</description>
    <group>zeek_custom,zeek_scanning,port_scan,</group>
  </rule>

  <rule id="100917" level="7">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/scanning.log</location>
    <field name="event_type">^udp_port_scan$</field>
    <description>Zeek: Possible UDP port scanning detected by IP $(src_ip), victim IP $(target_ip)</description>
    <group>zeek_custom,zeek_scanning,udp_port_scan,</group>
  </rule>

  <rule id="100918" level="7">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/scanning.log</location>
    <field name="event_type">^address_scan$</field>
    <description>Zeek: Possible TCP address scanning detected by IP $(src_ip)</description>
    <group>zeek_custom,zeek_scanning,address_scan,</group>
  </rule>

  <rule id="100919" level="6">
    <if_sid>100900</if_sid>
    <location>/var/log/zeek-custom/scanning.log</location>
    <field name="event_type">^icmp_host_scan$</field>
    <description>Zeek: Possible ICMP host scanning detected by IP $(src_ip)</description>
    <group>zeek_custom,zeek_scanning,icmp_host_scan,</group>
  </rule>

  <!-- SSH bruteforce -->


  <!--
       Base rule for dedicated Zeek SSH JSON decoder.

       ssh_bruteforce.log is transported with the zeek_ssh_json
       prefix and decoded by zeek-ssh-json.

       Level 0: grouping rule only, no standalone alert.
  -->
  <rule id="100922" level="0">
    <decoded_as>zeek-ssh-json</decoded_as>
    <location>/var/log/zeek-custom/ssh_bruteforce.log</location>
    <field name="event_source">^zeek$</field>
    <description>Zeek SSH dedicated JSON decoder base rule.</description>
    <group>zeek_custom,ssh,</group>
  </rule>
  <!--
       SSH brute-force activity detected by the custom Zeek
       correlation script.
  -->
  <rule id="100920" level="8">
    <if_sid>100900,100922</if_sid>

    <location>/var/log/zeek-custom/ssh_bruteforce.log</location>

    <field name="event_type">^ssh_bruteforce$</field>

    <description>Zeek: SSH brute force detected from $(src_ip):$(src_port) to $(dest_ip):$(dest_port). Failed connections: $(failed_connections), authentication attempts: $(auth_attempts), detection reason: $(detection_reason).</description>

    <mitre>
      <id>T1110</id>
    </mitre>

    <group>zeek_custom,ssh,ssh_bruteforce,authentication_attack,</group>
  </rule>


  <!--
       Successful SSH authentication observed shortly after
       Zeek detected brute-force activity from the same source.
  -->
  <rule id="100921" level="10">
    <if_sid>100900,100922</if_sid>

    <location>/var/log/zeek-custom/ssh_bruteforce.log</location>

    <field name="event_type">^ssh_bruteforce_success$</field>

    <description>Zeek: Successful SSH authentication after brute-force activity from $(src_ip):$(src_port) to $(dest_ip):$(dest_port). Previous failed connections: $(failed_connections), authentication attempts: $(auth_attempts).</description>

    <mitre>
      <id>T1110</id>
    </mitre>

    <group>zeek_custom,ssh,ssh_bruteforce,authentication_success,possible_compromise,</group>
  </rule>

</group>

