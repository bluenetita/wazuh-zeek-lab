{
  "policy": {
    "description": "Lab example: automatically delete Wazuh alert indices after 7 days",
    "schema_version": 17,
    "default_state": "retention",
    "states": [
      {
        "name": "retention",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_index_age": "7d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": ["wazuh-alerts-4.x-*"],
        "priority": 1
      }
    ]
  }
}
