SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 04:15 in the VM timezone (UTC in the validated lab).
15 4 * * * root /usr/bin/flock -n /run/wazuh-archives-retention.lock /usr/local/sbin/wazuh-archives-retention.sh --delete >> /var/log/wazuh-archives-retention.log 2>&1
